@page
@model OnlineShop.Admin.Pages.Checkout.SuccessModel
@{
    ViewData["Title"] = "Pago confirmado";
}

<div class="container py-4">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
            <div class="alert alert-warning">
                <h4 class="mb-2">No pudimos cargar el resumen</h4>
                <div>@Model.ErrorMessage</div>
            </div>

            <a class="btn btn-primary" href="/">Volver al inicio</a>
        return;
    }

    @if (Model.Order is null)
    {
            <div class="alert alert-info">Cargando resumen...</div>
        return;
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h1 class="h3 mb-3 text-success">Pago confirmado</h1>
            <p class="mb-1"><strong>Orden:</strong> @Model.Order.OrderId</p>
            <p class="mb-1"><strong>Estatus:</strong> @Model.Order.Status</p>
            <p class="mb-1"><strong>Fecha de pago:</strong> @(Model.Order.PaidAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "N/D")</p>
            <p class="mb-1"><strong>Correo:</strong> @Model.Order.CustomerEmail</p>
            <p class="mb-0"><strong>Proveedor:</strong> @Model.Order.Provider</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong>Artículos</strong>
                </div>
                <div class="card-body">
                    @if (Model.Order.Items.Count == 0)
                    {
                            <p class="mb-0 text-muted">No hay artículos.</p>
                    }
                    else
                    {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">Precio</th>
                                            <th class="text-end">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in Model.Order.Items)
                                    {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@item.ProductName</div>
                                                @if (!string.IsNullOrWhiteSpace(item.VariantSku) ||
                                                    !string.IsNullOrWhiteSpace(item.VariantSize) ||
                                                    !string.IsNullOrWhiteSpace(item.VariantColor))
                                                {
                                                            <div class="text-muted small">
                                                        @string.Join(" / ", new[] { item.VariantSku, item.VariantSize, item.VariantColor }.Where(x => !string.IsNullOrWhiteSpace(x)))
                                                            </div>
                                                }
                                                </td>
                                                <td class="text-end">@item.Quantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N2") @Model.Order.Currency</td>
                                                <td class="text-end">@item.LineTotal.ToString("N2") @Model.Order.Currency</td>
                                            </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <strong>Resumen</strong>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <strong>@Model.Order.Subtotal.ToString("N2") @Model.Order.Currency</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Envío</span>
                        <strong>@Model.Order.Shipping.ToString("N2") @Model.Order.Currency</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Impuestos</span>
                        <strong>@Model.Order.Tax.ToString("N2") @Model.Order.Currency</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold">Total</span>
                        <strong>@Model.Order.Total.ToString("N2") @Model.Order.Currency</strong>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Envío</strong>
                </div>
                <div class="card-body">
                    <div class="fw-semibold">@Model.Order.ShippingName</div>
                    <div>@Model.Order.ShippingPhone</div>
                    <div>@Model.Order.ShippingAddress1</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Order.ShippingAddress2))
                    {
                            <div>@Model.Order.ShippingAddress2</div>
                    }
                    <div>@Model.Order.ShippingCity, @Model.Order.ShippingState</div>
                    <div>@Model.Order.ShippingPostalCode, @Model.Order.ShippingCountry</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a class="btn btn-primary" href="/">Seguir comprando</a>
    </div>
</div>